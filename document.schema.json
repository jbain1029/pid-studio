{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PID Studio document v1",
  "type": "object",
  "required": ["format", "version", "title", "components", "connections"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "pid-studio"},
    "version": {"const": 1},
    "revision": {"type": "integer", "minimum": 0},
    "symbol_definitions": {"type":"object","maxProperties":64,"propertyNames":{"pattern":"^custom:[a-z][a-z0-9_]{0,47}$"},"additionalProperties":{"$ref":"#/$defs/custom_symbol"}},
    "review_history": {"type":"array","items":{"$ref":"#/$defs/review_record"}},
    "title": {"type": "string"},
    "notes": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","text","position","width"],"properties":{"id":{"type":"string","minLength":1},"text":{"type":"string"},"position":{"$ref":"#/$defs/point"},"width":{"type":"number","minimum":80,"maximum":2000}}}},
    "metadata": {"$ref": "#/$defs/metadata"},
    "reference": {"type":"object", "additionalProperties":false, "required":["filename","data","position","width","opacity"], "properties": {
      "filename":{"type":"string"}, "data":{"type":"string","maxLength":28000000},
      "position":{"$ref":"#/$defs/point"}, "width":{"type":"number","minimum":100,"maximum":10000},
      "opacity":{"type":"number","minimum":0,"maximum":1}
    }},
    "components": {"type": "array", "items": {"$ref": "#/$defs/component"}},
    "connections": {"type": "array", "items": {"$ref": "#/$defs/connection"}}
  },
  "$defs": {
    "symbol_point": {"type":"array","items":{"type":"number","minimum":-45,"maximum":45},"minItems":2,"maxItems":2},
    "primitive": {"oneOf":[
      {"type":"object","additionalProperties":false,"required":["kind","points"],"properties":{"kind":{"const":"line"},"points":{"type":"array","items":{"$ref":"#/$defs/symbol_point"},"minItems":2,"maxItems":2}}},
      {"type":"object","additionalProperties":false,"required":["kind","points"],"properties":{"kind":{"const":"polyline"},"points":{"type":"array","items":{"$ref":"#/$defs/symbol_point"},"minItems":2,"maxItems":64}}},
      {"type":"object","additionalProperties":false,"required":["kind","points"],"properties":{"kind":{"const":"polygon"},"points":{"type":"array","items":{"$ref":"#/$defs/symbol_point"},"minItems":3,"maxItems":64}}},
      {"type":"object","additionalProperties":false,"required":["kind","rect"],"properties":{"kind":{"enum":["rect","ellipse"]},"rect":{"type":"array","items":{"type":"number","minimum":-45,"maximum":90},"minItems":4,"maxItems":4}}}
    ]},
    "custom_symbol": {
      "type":"object","additionalProperties":false,
      "required":["label","prefix","category","ports","port_kinds","routing_bounds","artwork"],
      "properties":{
        "label":{"type":"string","minLength":1,"maxLength":80},
        "prefix":{"type":"string","pattern":"^[A-Z][A-Z0-9]{0,11}$"},
        "category":{"type":"string","minLength":1,"maxLength":80},
        "ports":{"type":"object","minProperties":1,"maxProperties":16,"propertyNames":{"pattern":"^[a-z][a-z0-9_]{0,31}$"},"additionalProperties":{"type":"array","items":{"type":"number","minimum":-50,"maximum":50},"minItems":2,"maxItems":2}},
        "port_kinds":{"type":"object","minProperties":1,"maxProperties":16,"propertyNames":{"pattern":"^[a-z][a-z0-9_]{0,31}$"},"additionalProperties":{"enum":["process","signal"]}},
        "routing_bounds":{"type":"array","items":{"type":"number","minimum":-45,"maximum":45},"minItems":4,"maxItems":4},
        "artwork":{"type":"array","minItems":1,"maxItems":128,"items":{"$ref":"#/$defs/primitive"}}
      }
    },
    "sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "generation_record": {
      "type":"object","additionalProperties":false,
      "required":["version","provider","requested_at","received_at","requested_model","response_model","response_id","base_fingerprint","request_fingerprint","user_instruction_fingerprint","instructions_fingerprint","wire_schema_fingerprint","catalog_fingerprint","document_schema_fingerprint","image_included","sent_image_fingerprint","input_tokens","output_tokens","total_tokens"],
      "properties":{
        "version":{"const":1},"provider":{"const":"openai"},
        "requested_at":{"type":"string","minLength":1},"received_at":{"type":["string","null"]},
        "requested_model":{"type":"string","minLength":1},
        "response_model":{"type":["string","null"],"maxLength":256},
        "response_id":{"type":["string","null"],"maxLength":256},
        "base_fingerprint":{"$ref":"#/$defs/sha256"},
        "request_fingerprint":{"$ref":"#/$defs/sha256"},
        "user_instruction_fingerprint":{"$ref":"#/$defs/sha256"},
        "instructions_fingerprint":{"$ref":"#/$defs/sha256"},
        "wire_schema_fingerprint":{"$ref":"#/$defs/sha256"},
        "catalog_fingerprint":{"$ref":"#/$defs/sha256"},
        "document_schema_fingerprint":{"$ref":"#/$defs/sha256"},
        "image_included":{"type":"boolean"},
        "sent_image_fingerprint":{"anyOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]},
        "input_tokens":{"type":["integer","null"],"minimum":0},
        "output_tokens":{"type":["integer","null"],"minimum":0},
        "total_tokens":{"type":["integer","null"],"minimum":0}
      }
    },
    "review_record": {
      "type":"object","additionalProperties":false,
      "required":["id","accepted_at","base_fingerprint","proposal_fingerprint","source_fingerprint","catalog_fingerprint","schema_fingerprint","authoring_fingerprint","proposal_json","acknowledged_ids"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "generation":{"$ref":"#/$defs/generation_record"},
        "accepted_at":{"type":"string","minLength":1},
        "base_fingerprint":{"$ref":"#/$defs/sha256"},
        "proposal_fingerprint":{"$ref":"#/$defs/sha256"},
        "source_fingerprint":{"anyOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]},
        "catalog_fingerprint":{"$ref":"#/$defs/sha256"},
        "schema_fingerprint":{"$ref":"#/$defs/sha256"},
        "authoring_fingerprint":{"$ref":"#/$defs/sha256"},
        "proposal_json":{"type":"string"},
        "acknowledged_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true}
      }
    },
    "metadata": {"type": "object", "additionalProperties": {"type": "string"}},
    "point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "endpoint": {"type": "object", "additionalProperties": false, "required": ["component", "port"], "properties": {"component": {"type": "string"}, "port": {"type": "string"}}},
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "tag", "description", "position", "rotation"],
      "properties": {
        "metadata": {"$ref": "#/$defs/metadata"},
        "id": {"type": "string", "minLength": 1}, "type": {"type":"string","minLength":1,"maxLength":64},
        "tag": {"type": "string", "minLength": 1}, "description": {"type": "string"},
        "position": {"$ref": "#/$defs/point"}, "rotation": {"enum": [0, 90, 180, 270]}
      }
    },
    "connection": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "from", "to", "kind", "label", "waypoints"],
      "properties": {
        "metadata": {"$ref": "#/$defs/metadata"},
        "id": {"type": "string", "minLength": 1}, "from": {"$ref": "#/$defs/endpoint"}, "to": {"$ref": "#/$defs/endpoint"},
        "kind": {"enum": ["process", "signal"]}, "label": {"type": "string"},
        "waypoints": {"type": "array", "items": {"$ref": "#/$defs/point"}}
      }
    }
  }
}
